<Window x:Class="TatehamaInterlockingConsole.Views.EnvironmentSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="環境選択"
        Width="400" Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF4C6666"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="接続先環境を選択してください:"
                   Foreground="#FFF7F7F7" FontSize="16" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" x:Name="EnvironmentPanel" Orientation="Vertical"/>

        <StackPanel Grid.Row="2" x:Name="LocalUrlPanel" Orientation="Vertical" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Text="ローカルURL:" Foreground="#FFF7F7F7" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="LocalUrlTextBox" Width="340" Height="24" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConnectButton" Content="接続" Width="90" Height="30" Margin="5,0"
                    Click="ConnectButton_Click"/>
            <Button x:Name="CancelButton" Content="キャンセル" Width="90" Height="30" Margin="5,0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
